// RTRN (Regen Hood 0) — this community's MyCoNet settings.
// The build reads this file and generates web/wrangler.jsonc and the public env vars.
// No secrets here: the anon key is public by design; the service-role key, AI keys
// and chat tokens are Cloudflare secrets (`npx wrangler secret put …`).
{
  "id": "rtrn",
  "displayName": "Regen Hood 0",

  // The look: "v4" = Sonia's redesign (DESIGN-SYSTEM.md › v4). Turned on 2026-11-20 (Oscar: "make RTRN be fully caught up including looks").
  "design": "v4",

  "appUrl": "https://myconet.correa-oscar11.workers.dev",

  // Meetings (2026-11-20, Oscar: "for now just the ones we upload audio for"): uploads only, transcribed by
  // Fireflies (FIREFLIES_API_KEY + FIREFLIES_WEBHOOK_SECRET). No /api/fireflies-ingest (no PROTOPIA_INGEST_SECRET),
  // no V2 webhook. Notes go to the second brain (knowledge below). Costa Rica = same offset as Mérida (UTC-6, no DST).
  "modules": ["meetings"],
  "timeZone": "America/Costa_Rica",

  "cloudflare": {
    // Worker name = the *.workers.dev subdomain and the WORKER_SELF_REFERENCE service
    "workerName": "myconet"
    // "accountId": "…"   // set when the community deploys from its own Cloudflare account
  },

  "supabase": {
    "url": "https://vzgoulsqmhvhbjhzlzkf.supabase.co",
    "anonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ6Z291bHNxbWh2aGJqaHpsemtmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc2ODY1MjMsImV4cCI6MjA5MzI2MjUyM30.q3YfwcTFGv6U5eN1Sj031Ia1V-tMtcboZ82PWFQuXg4"
  },

  // RTRN's own second brain (not rt-brain, which is the Regen Tribe collective's). MyCoNet keeps a folder per circle
  // there (README + board.md). Off until the SECOND_BRAIN_GITHUB_TOKEN secret exists (fine-grained, this repo only,
  // Contents read/write).
  // Ask and Do read the second brain (v4.74.0; Oscar 2026-11-20: tiered — members the meeting notes and boards,
  // leads and admins also the hand-written notes).
  "assistant": { "secondBrain": true },

  "knowledge": { "repo": "regen-Tribe/rtrn-second-brain", "branch": "main", "meetingsFolder": "operations/meetings" }
}
