// A new community's MyCoNet settings. Copy this folder to `instance/` and fill it in.
// The build reads it and generates web/wrangler.jsonc and the public env vars.
// No secrets here: the Supabase anon key is public by design; the service-role key,
// AI keys and chat tokens are Cloudflare secrets (`npx wrangler secret put …`).
{
  // Short id, lowercase letters/numbers/dashes (used in names and logs)
  "id": "my-community",
  // Shown where the portal names the community until the Blueprint has a name
  "displayName": "My Community",

  // Where the portal will live (no trailing slash)
  "appUrl": "https://myconet-my-community.<your-subdomain>.workers.dev",

  "cloudflare": {
    // Worker name: lowercase letters, numbers, dashes. Becomes <workerName>.<subdomain>.workers.dev
    "workerName": "myconet-my-community",
    // Your Cloudflare account ID (dashboard → Workers & Pages → right sidebar)
    "accountId": ""
  },

  "supabase": {
    // Supabase dashboard → Project Settings → API
    "url": "https://<project-ref>.supabase.co",
    "anonKey": ""
  },

  // Optional modules to turn on. "meetings": meeting recordings transcribed by Fireflies
  // (needs the FIREFLIES_API_KEY, FIREFLIES_WEBHOOK_SECRET, FIREFLIES_SIGNING_SECRET and SUPABASE_SERVICE_ROLE_KEY secrets)
  // "points": show points on screen (they are always recorded in points_log; LEXICON.md)
  "modules": [],

  // The look. "v4" = the pastel redesign (DESIGN-SYSTEM.md › v4); leave empty for the current look.
  "design": "",

  // Time zone for task times and dates said in meetings ("by Friday")
  "timeZone": "UTC",

  // Optional: the community's second brain on GitHub. Meeting notes are saved to
  // operations/meetings/ (needs the SECOND_BRAIN_GITHUB_TOKEN secret: a fine-grained token for
  // this repo only, Contents read and write)
  // "knowledge": { "repo": "owner/second-brain", "branch": "main", "meetingsFolder": "operations/meetings", "boardFolder": "operations/board" },

  // Optional: email a meeting's notes to its circle's leads (needs MEETINGS_SMTP_PASSWORD, e.g. a
  // Gmail app password for `from`). alwaysTo: portal usernames who get every meeting's notes.
  // "meetings": { "notesEmail": { "from": "you@gmail.com", "smtpHost": "smtp.gmail.com", "smtpPort": 465, "alwaysTo": [] } }
}
